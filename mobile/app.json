{
  "expo": {
    "name": "STAR AI",
    "slug": "star-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "starai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-image-picker", { "photosPermission": "STAR AI needs access to your photos for image analysis.", "cameraPermission": "STAR AI needs camera access for image analysis.", "microphonePermission": false }]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.starai.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.starai.app"
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
