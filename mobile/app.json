{
  "expo": {
    "name": "STAR AI",
    "slug": "star-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "starai",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060608",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "STAR AI يحتاج الوصول إلى صورك لاختيار صورة للتحليل أو التحرير.",
          "cameraPermission": "STAR AI يحتاج الوصول إلى الكاميرا لالتقاط صورة للتحليل أو التحرير.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.starai.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.starai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#060608"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
